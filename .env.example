# ---- Mode ---------------------------------------------------------------
# SAMPLE_MODE=true runs with no Zetaris, no Nightshift and no credentials:
# data comes from data/sample/, model replies from cassettes/ (recorded live runs).
SAMPLE_MODE=true
PORT=5178

# ---- Zetaris (data layer) ------------------------------------------------
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_TIMEOUT_MS=60000

# ---- Meterless Nightshift (primary AI provider) ---------------------------
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP=gauntlet
# Pinned Nemotron lanes (logged on every call). Ids from GET /v1/models.
METERLESS_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_MODEL_DEEP=nvidia/nemotron-3-ultra-550b-a55b
METERLESS_MODEL_FALLBACK=nvidia/nemotron-3.5-bolt-e4b
METERLESS_TIMEOUT_MS=120000

# ---- Local demo Postgres (the enterprise source Zetaris federates) --------
PGHOST_FOR_ZETARIS=host.docker.internal
PGPORT=5434
PGUSER=gauntlet_owner
PGPASSWORD=gauntlet_owner_local_only
# Per-role logins: Zetaris datasource crm_analyst uses ANALYST, crm_admin uses ADMIN.
PG_ANALYST_USER=gauntlet_analyst
PG_ANALYST_PASSWORD=analyst_local_only
PG_ADMIN_USER=gauntlet_admin
PG_ADMIN_PASSWORD=admin_local_only
